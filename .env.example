
# Staff assistant (api/agent.js). Create a key at platform.claude.com → API Keys.
# Set the same variable in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Free option: Google Gemini. When set, the assistant uses Gemini instead of Claude.
# Create a key at aistudio.google.com → Get API key. Optional: GEMINI_MODEL (default gemini-3.6-flash).
GEMINI_API_KEY=
