{
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/agent.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
