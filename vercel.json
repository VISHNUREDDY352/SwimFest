{
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/agent.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/core/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/addevent",
      "destination": "/orgcreate",
      "permanent": true
    },
    {
      "source": "/addevent.html",
      "destination": "/orgcreate",
      "permanent": true
    },
    {
      "source": "/racecontrol",
      "destination": "/orgracecontrol",
      "permanent": true
    },
    {
      "source": "/racecontrol.html",
      "destination": "/orgracecontrol",
      "permanent": true
    },
    {
      "source": "/emdashboard",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/emdashboard.html",
      "destination": "/admin",
      "permanent": true
    }
  ]
}
